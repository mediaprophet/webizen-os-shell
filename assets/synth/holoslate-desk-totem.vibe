requires [capability("capability.invoke")];
// Holoslate multi-ring spatial command totem.
// Stacked refractive rings on a slender stem.
let totem = capability.invoke("hypermedia.manifold.revolve", {
  points: [
    [5.6, 0.0],
    [5.6, 1.6],
    [2.15, 1.8],
    [2.15, 4.1],
    [7.6, 4.3],
    [7.6, 6.1],
    [2.0, 6.3],
    [2.0, 9.2],
    [6.6, 9.4],
    [6.6, 11.2],
    [1.55, 11.4],
    [1.55, 16.2],
    [4.1, 16.4],
    [0.75, 18.2]
  ],
  segments: 48,
  caps: true
});
let ten_d = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
  mesh: totem,
  topology: true,
  spatial_index: true,
  camera_position: [18.0, 12.0, 22.0],
  camera_target: [0.0, 9.0, 0.0],
  camera_up: [0.0, 1.0, 0.0],
  camera_fov: 36.0,
  camera_near: 0.1
});
let asset = { files: [{ key: "holoslate-desk-totem.10d", resource: ten_d }] };
