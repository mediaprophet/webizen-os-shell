    {id:"deb3",role:"card",label:"TARGET 3: Linux Host Platform\n(webizen-hostd.deb)\n\nDebian 13 Trixie VPS / Server\nO(1) 48B NQuin DNS + QPolicy\nns.webcivics.net + Solid Pod\nhost_state.cbor-ld (0xD90501)\nwebizen-host-apply-update Gate",x:726,y:138,width:288,height:164,state:"focus"},
