    {id:"footer",role:"footer",label:"Tri-Target Debian 13 Trixie (.deb)  ·  Android 16 AVF pKVM EL2 Sanctuary  ·  M-of-N Natural-Person Host Update Gate",x:0,y:600,width:1024,height:40,state:"default"}
