    {id:"deb1",role:"card",label:"TARGET 1: Desktop Steward\n(webizen-desktop-appliance.deb)\n\nDebian 13 Trixie amd64 / arm64\nWayland Cage + Etalon Vulkan\nFour-Plane Identifier Fabric\nPoet + 150-Morphism Synth\nPrimary Quorum Signer (:8080)",x:126,y:138,width:288,height:164,state:"default"},
