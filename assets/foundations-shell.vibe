let theme = capability.invoke("hypermedia.layout.bind_theme_scope", {
  scope:"environment",
  mode:"holosonic-dark",
  accent:[77,184,255,255],
  corner_radius:16.0
});
let ui = capability.invoke("hypermedia.layout.render_ui_sheet", {layout:layout,theme:theme,font:"ui-font.ttf",scale:1.0});
let png = capability.invoke("hypermedia.radiance.encode_rgba_png", {image:ui});
let svg = capability.invoke("hypermedia.layout.project_ui_svg", {layout:layout,theme:theme,font:"ui-font.ttf",scale:1.0});
let diegetic = capability.invoke("hypermedia.layout.project_diegetic_surface", {
  ui_image:ui,
  viewport_width:1024,
  viewport_height:640,
  yaw_deg:-6.0,
  pitch_deg:5.0,
  pick_screen_xy:[512.0,320.0]
});
let diegeticPng = capability.invoke("hypermedia.radiance.encode_rgba_png", {image:diegetic.projected_rgba});
let gallery = capability.invoke("hypermedia.discourse.review_gallery", {
  title:"Webizen OS-Shell — 10-Section Settings & Four-Plane Identifier Fabric",
  files:[
    {name:"foundations-sheet.png",resource:png},
    {name:"foundations-sheet.svg",resource:svg},
    {name:"foundations-diegetic.png",resource:diegeticPng}
  ]
});
let asset={files:[
  {key:"foundations-sheet.png",resource:png},
  {key:"foundations-sheet.svg",resource:svg},
  {key:"foundations-diegetic.png",resource:diegeticPng},
  {key:"review-gallery.html",resource:gallery}
]};
